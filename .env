# ── Local SQLite (development / fallback) ──
DATABASE_URL=file:/home/z/my-project/db/custom.db

# ── Supabase Cloud (production — Vercel) ──
# Get these from: https://supabase.com/dashboard → Your Project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Connection pooler URL (for Prisma) — from Supabase → Settings → Database
# When set, DATABASE_URL is overridden with this PostgreSQL connection string
DIRECT_URL=
